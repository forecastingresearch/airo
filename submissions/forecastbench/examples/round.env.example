# scripts/fb_round.sh's machine settings. Copy to ~/.config/fri-forecaster/round.env
# (or point FORECASTER_ROUND_ENV at it); sourced by bash, every variable exported.
# Keep it out of the repo: it names the team.

FB_ORG="Anonymous 0"                               # the team's anonymous ForecastBench name (required): every set
                                                   # goes up under it, but the one the registry marks public
FB_PUBLIC_ORG="Example Team"                       # the team's own name, for that one (required if there is one)
FORECASTER_NAMES="$HOME/.config/fri-forecaster/names.json"   # the private name registry
ROUNDS_DIR="$HOME/forecastbench/rounds"            # default: <checkout>/rounds
# CALLS=12                                         # pi calls at once (a pi process is some 130 MB; mind rate limits)
# TIMEOUT=900                                      # seconds per pi call
# FORECASTER_ENV_FILE="$HOME/.config/fri-forecaster/env"     # API keys, KEY=value lines (the default)
# FORECASTER_PI="$HOME/pi/node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js"  # default: the checkout's npm ci
# PI_CODING_AGENT_DIR="$HOME/.config/fri-forecaster/pi-agent"  # (the default)
# PATH="$HOME/.local/node/bin:$PATH"               # if node is not on PATH

# Optional: the panel, one model per line, best by ECI first, as
# `<Epoch name> TAB <pi model id> TAB <lab>`. names.py registers a condition's next
# place when its members are not the panel's top N. On AIRO's box the panel is AIRO's,
# refreshed from Epoch's index first (code/refresh_panel.sh, which pages a change):
# panel_members() { (cd "$HOME/Projects/airo" && { code/refresh_panel.sh >&2; "$PY" -m redlines.registry 6; }); }
# Or, with no AIRO checkout, the shared panel over a directory of snapshots:
# panel_members() { "$PY" -m fri_forecaster.panel --dir "$HOME/.cache/fri-forecaster/eci" 6; }
# Without this, the round ranks Epoch's published index by name
# (`python -m fri_forecaster.eci --fetch --names`) and can only warn when the top N moved.
